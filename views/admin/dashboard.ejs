<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — <%= SITE.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-shell">

<div class="admin-topbar">
  <span><strong>Corporate Seva Kendra</strong> — Admin Dashboard</span>
  <div style="display:flex;gap:10px;align-items:center;">
    <a href="/" style="color:var(--paper);font-size:.85rem;" target="_blank">View site ↗</a>
    <form method="POST" action="/admin/logout"><button type="submit">Log out</button></form>
  </div>
</div>

<div class="admin-wrap">

  <div class="admin-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <h2>Blog Posts (<%= blogs.length %>)</h2>
      <a href="/admin/blog/new" class="btn btn--brass">+ New Post</a>
    </div>
    <table class="admin-table">
      <thead>
        <tr><th>Cover</th><th>Title</th><th>Category</th><th>Date</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% if (blogs.length === 0) { %>
          <tr><td colspan="5">No blog posts yet. Click "New Post" to add your first one.</td></tr>
        <% } %>
        <% blogs.forEach(function(b){ %>
        <tr>
          <td>
            <% if (b.cover) { %><img class="cover-preview" src="<%= b.cover %>" alt=""><% } else { %><div class="cover-preview"></div><% } %>
          </td>
          <td><strong><%= b.title %></strong><br><span style="color:var(--slate);font-size:.8rem;">/blog/<%= b.slug %></span></td>
          <td><%= b.category %></td>
          <td><%= b.date %></td>
          <td>
            <div class="row-actions">
              <a href="/admin/blog/edit/<%= b.id %>">Edit</a>
              <a href="/blog/<%= b.slug %>" target="_blank">View</a>
              <form method="POST" action="/admin/blog/delete/<%= b.id %>" onsubmit="return confirm('Delete this post? This cannot be undone.');">
                <button type="submit" class="danger">Delete</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="admin-card">
    <h2 style="margin-bottom:16px;">Contact Form Leads (<%= leads.length %>)</h2>
    <table class="admin-table">
      <thead>
        <tr><th>Name</th><th>Contact</th><th>Service</th><th>Message</th><th>Received</th><th></th></tr>
      </thead>
      <tbody>
        <% if (leads.length === 0) { %>
          <tr><td colspan="6">No enquiries received yet.</td></tr>
        <% } %>
        <% leads.forEach(function(l){ %>
        <tr>
          <td><%= l.name %><br><span style="color:var(--slate);font-size:.8rem;"><%= l.state %></span></td>
          <td><%= l.phone %><br><span style="color:var(--slate);font-size:.8rem;"><%= l.email %></span></td>
          <td><%= l.serviceRequired %></td>
          <td style="max-width:220px;"><%= l.message %></td>
          <td><%= new Date(l.date).toLocaleDateString('en-IN') %></td>
          <td>
            <form method="POST" action="/admin/lead/delete/<%= l.id %>" onsubmit="return confirm('Delete this enquiry?');">
              <button type="submit" class="danger">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</div>
</body>
</html>
