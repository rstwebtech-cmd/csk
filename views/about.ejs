<% var pageTitle = 'About Us — ' + SITE.name %>
<%- include('partials/header') %>

<section class="hero" style="padding-bottom:0;">
  <div class="wrap" style="padding: 70px 24px 60px;">
    <span class="hero__eyebrow">About Corporate Seva Kendra</span>
    <h1 style="max-width:20ch;">Chartered Accountants built around long-term relationships, not one-off filings.</h1>
    <p class="lead">We are a Delhi-based Chartered Accountant firm serving founders and businesses across India — from first registration to ongoing compliance.</p>
  </div>
</section>

<section>
  <div class="wrap about-strip">
    <div>
      <span class="section__kicker">Our story</span>
      <h2>A single desk for incorporation, tax and compliance</h2>
      <p>Corporate Seva Kendra was built to remove the friction founders feel when they have to run between a CA for taxes, a CS for filings, and a lawyer for trademarks. We bring incorporation, accounting, GST, income tax, payroll and licensing under one roof, with a team that already has full context on your business.</p>
      <p>We offer services in New Delhi and other major cities in India, including accounts outsourcing, auditing, company formation, business taxation, corporate compliance, registration of foreign companies, transfer pricing, tax due diligence and taxation of expatriates.</p>
    </div>
    <div class="about-strip__figure">
      <h3 style="color:var(--paper)">Our commitments</h3>
      <div class="hero__ledger-row" style="border-color:rgba(242,239,229,.15);"><span>Transparent dealings</span></div>
      <div class="hero__ledger-row" style="border-color:rgba(242,239,229,.15);"><span>Customised, not templated advice</span></div>
      <div class="hero__ledger-row" style="border-color:rgba(242,239,229,.15);"><span>End-to-end, practical solutions</span></div>
      <div class="hero__ledger-row" style="border-color:rgba(242,239,229,.15);"><span>Specialists across every service line</span></div>
    </div>
  </div>
</section>

<section class="section--tinted">
  <div class="wrap">
    <div class="section__head center">
      <span class="section__kicker">Vision, mission &amp; objective</span>
      <h2>What guides how we work</h2>
    </div>
    <div class="subgrid">
      <div class="subgrid__item">
        <h4>Vision</h4>
        <p>To be the premier accounting and consultancy firm — delivering excellent client service and a strong quality of life for our own team.</p>
      </div>
      <div class="subgrid__item">
        <h4>Mission</h4>
        <p>To work as genuine partners with organisations, including in the charitable and voluntary sectors, helping them reach the outcomes they set out for.</p>
      </div>
      <div class="subgrid__item">
        <h4>Objective</h4>
        <p>To build long-term relationships grounded in real experience and expertise, so our clients achieve lasting, measurable success.</p>
      </div>
      <div class="subgrid__item">
        <h4>Excellence in Service</h4>
        <p>To consistently exceed expectations through teamwork, professionalism, personalised attention and deep specialisation.</p>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap about-strip">
    <div class="about-strip__figure" style="order:2;">
      <div class="stat-row" style="grid-template-columns:1fr 1fr;">
        <div class="stat"><b>1200+</b><span>Clients served</span></div>
        <div class="stat"><b>10+ yrs</b><span>Team experience</span></div>
        <div class="stat"><b>7</b><span>States actively served</span></div>
        <div class="stat"><b>7</b><span>Service categories</span></div>
      </div>
    </div>
    <div>
      <span class="section__kicker">Why Corporate Seva Kendra</span>
      <h2>Why go for Corporate Seva Kendra?</h2>
      <p>With experienced Chartered Accountants in Delhi, we take a modern, solution-based and result-oriented approach — staying current on the latest technology and software in business management, and keeping every engagement transparent from quote to delivery.</p>
      <p>No two clients are the same, so our approach is customised to your business's demands. Our CAs provide end-to-end solutions and keep things practical, with specialists across tax consultancy, accounting, GST, start-ups and more.</p>
    </div>
  </div>
</section>

<section class="section--navy">
  <div class="wrap" style="text-align:center;">
    <h2>Talk to our team</h2>
    <p style="max-width:44ch;margin:0 auto 26px;">Tell us about your business and we'll point you to the right service, no obligation.</p>
    <a href="/contact" class="btn btn--brass">Get a Quote</a>
  </div>
</section>

<%- include('partials/footer') %>
