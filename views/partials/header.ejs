<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : SITE.name + ' — Chartered Accountants, GST & Company Registration in Delhi' %></title>
<meta name="description" content="<%= typeof pageDesc !== 'undefined' ? pageDesc : 'Corporate Seva Kendra — Chartered Accountant firm in Delhi offering company incorporation, GST, income tax, trademark, payroll and licensing services.' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="topbar">
  <div class="wrap topbar__inner">
    <span>Delhi NCR · Chartered Accountants &amp; Company Registration</span>
    <span class="topbar__contact">
      <a href="tel:<%= SITE.phone %>"><%= SITE.phoneDisplay %></a>
      <a href="mailto:<%= SITE.email %>"><%= SITE.email %></a>
    </span>
  </div>
</div>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="1" width="38" height="38" rx="4" stroke="currentColor" stroke-width="1.4"/>
          <path d="M11 26V14l9 8 9-8v12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">Corporate Seva Kendra</span>
        <span class="brand__sub">Chartered Accountants</span>
      </span>
    </a>

    <nav class="nav" id="siteNav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a>
      <div class="nav__dropdown">
        <a href="/services" class="<%= currentPath.startsWith('/services') ? 'active' : '' %>">Services</a>
        <div class="nav__menu">
          <a href="/services/incorporation">Incorporation</a>
          <a href="/services/compliance">Compliance</a>
          <a href="/services/trademark">Trademark &amp; IP</a>
          <a href="/services/gst">GST</a>
          <a href="/services/income-tax">Income Tax</a>
          <a href="/services/payroll">Payroll</a>
          <a href="/services/licenses">Licenses</a>
        </div>
      </div>
      <a href="/blog" class="<%= currentPath.startsWith('/blog') ? 'active' : '' %>">Blog</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>

    <a href="/contact" class="btn btn--brass nav__cta">Get a Quote</a>
    <button class="nav__toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
