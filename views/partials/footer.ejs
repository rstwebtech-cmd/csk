<footer class="site-footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <span class="brand__name" style="color:var(--paper)">Corporate Seva Kendra</span>
      <p>Chartered Accountants serving Delhi NCR with incorporation, taxation, compliance and licensing under one roof.</p>
      <div class="footer__social">
        <a href="<%= SITE.social.facebook %>" aria-label="Facebook" target="_blank" rel="noopener">FB</a>
        <a href="<%= SITE.social.twitter %>" aria-label="Twitter" target="_blank" rel="noopener">X</a>
        <a href="<%= SITE.social.linkedin %>" aria-label="LinkedIn" target="_blank" rel="noopener">in</a>
        <a href="<%= SITE.social.instagram %>" aria-label="Instagram" target="_blank" rel="noopener">IG</a>
      </div>
    </div>

    <div class="footer__col">
      <h4>Links</h4>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer__col">
      <h4>Services</h4>
      <a href="/services/incorporation">Incorporation</a>
      <a href="/services/compliance">Compliance</a>
      <a href="/services/gst">GST</a>
      <a href="/services/income-tax">Income Tax</a>
      <a href="/services/payroll">Payroll</a>
    </div>

    <div class="footer__col">
      <h4>Get in touch</h4>
      <p><%= SITE.address %></p>
      <p><a href="tel:<%= SITE.phone %>"><%= SITE.phoneDisplay %></a></p>
      <p><a href="mailto:<%= SITE.email %>"><%= SITE.email %></a></p>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <span>© <%= new Date().getFullYear() %> Corporate Seva Kendra. All rights reserved.</span>
    <a href="/admin/login">Admin</a>
  </div>
</footer>

