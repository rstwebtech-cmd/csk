<% var pageTitle = 'Contact Us — ' + SITE.name %>
<%- include('partials/header') %>

<section class="hero" style="padding-bottom:0;">
  <div class="wrap" style="padding: 70px 24px 60px;">
    <span class="hero__eyebrow">Contact</span>
    <h1 style="max-width:20ch;">Tell us what you need, and one of our specialists will call you back.</h1>
  </div>
</section>

<section>
  <div class="wrap contact-grid">
    <div>
      <% if (submitted) { %>
        <div class="alert-success">Thanks — your request has been received. Our team will reach out shortly.</div>
      <% } %>
      <form action="/contact" method="POST">
        <div class="form-row">
          <div class="form-field">
            <label for="name">Full Name *</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="phone">Mobile Number *</label>
            <input type="tel" id="phone" name="phone" required>
          </div>
          <div class="form-field">
            <label for="state">State *</label>
            <select id="state" name="state" required>
              <option value="">Select</option>
              <option>New Delhi</option>
              <option>Haryana</option>
              <option>Mumbai</option>
              <option>Rajasthan</option>
              <option>Uttar Pradesh</option>
              <option>Himachal Pradesh</option>
              <option>Punjab</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="form-field">
          <label for="serviceRequired">Service Required *</label>
          <select id="serviceRequired" name="serviceRequired" required>
            <option value="">Please choose</option>
            <option>Incorporation</option>
            <option>Compliance</option>
            <option>Trademark</option>
            <option>GST</option>
            <option>Income Tax</option>
            <option>Payroll</option>
            <option>Licenses</option>
          </select>
        </div>
        <div class="form-field">
          <label for="message">More Information</label>
          <textarea id="message" name="message" rows="4"></textarea>
        </div>
        <button type="submit" class="btn btn--brass btn--block">Submit</button>
      </form>
    </div>

    <div class="contact-info">
      <div class="contact-info__item">
        <div>
          <b>Office</b>
          <p><%= SITE.address %></p>
        </div>
      </div>
      <div class="contact-info__item">
        <div>
          <b>Phone</b>
          <p><a href="tel:<%= SITE.phone %>"><%= SITE.phoneDisplay %></a></p>
        </div>
      </div>
      <div class="contact-info__item">
        <div>
          <b>Email</b>
          <p><a href="mailto:<%= SITE.email %>"><%= SITE.email %></a></p>
        </div>
      </div>
      <div class="contact-info__item">
        <div>
          <b>WhatsApp</b>
          <p><a href="<%= SITE.whatsapp %>" target="_blank" rel="noopener">Chat with us instantly</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
